root = true

[{doc/**,*.md}]
ignore = true

[{*.{c,h,cpp,hpp,s,S},Makefile}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab 
indent_size = 8
trim_trailing_whitespace = true

[*.py]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
