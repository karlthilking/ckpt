/* fd_table.c */
#include "xnd/xnd.h"
#include "xnd/xnd_lib.h"
#include "xnd/fd_table.h"
#include <errno.h>
#include <fcntl.h>
#include <pthread.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>

static struct fd_state fd_table[MAXFILES];
static pthread_mutex_t fd_table_lock = PTHREAD_MUTEX_INITIALIZER;

static inline bool fd_state_ignore(void)
{
	return get_xnd_state() == XND_UNINITIALIZED;
}

static int fd_backing_save(int fd)
{
	int ret;
	struct fd_state *state;
	struct fd_backing *src;

	state = &fd_table[fd];
	src = state->src;

	if ((src->off = lseek(fd, 0, SEEK_CUR)) < 0) {
		xnd_perror("lseek");
		return -1;
	}

	if ((ret = fcntl(fd, F_GETFL)) < 0) {
		xnd_perror("fcntl");
		return -1;
	} else {
		src->flags |= (ret & (O_APPEND | O_NONBLOCK));
	}

	if ((ret = fcntl(fd, F_GETFD)) < 0) {
		xnd_perror("fcntl");
		return -1;
	}

	if ((src->flags & O_CLOEXEC) && !(ret & FD_CLOEXEC))
		src->flags &= ~O_CLOEXEC;
	else if ((ret & FD_CLOEXEC) && !(src->flags & O_CLOEXEC))
		 src->flags |= O_CLOEXEC;

	/**
	 * Filter out flags here (rather than at reopen time) that would
	 * corrupt/refuse the reopen if reapplied verbatim: truncating an
	 * already-restored file, or failing because the file already
	 * exists.
	 */
	src->flags &= ~O_TRUNC;
	src->flags &= ~O_EXCL;

	src->state = FD_STATE_SAVED;
	return 0;
}

static int fd_backing_restore(int fd)
{
	int ret;
	struct fd_state *state;
	struct fd_backing *src;

	state = &fd_table[fd];
	src = state->src;
	xnd_assert(state->type != FD_INHERITED);

	ret = open(src->path, src->flags, src->mode);
	if (ret < 0) {
		xnd_perror("open");
		return -1;
	} else if (ret != fd) {
		if (dup2(ret, fd) != fd) {
			xnd_perror("dup2");
			return -1;
		}
		close(ret);
	}

	if (lseek(fd, src->off, SEEK_SET) != src->off) {
		xnd_perror("lseek");
		return -1;
	}

	src->reopen = fd;
	src->state = FD_STATE_RESTORED;
	return 0;
}

void fd_table_init(void)
{
	int fd;

	fd_table[0].type = FD_INHERITED;
	fd_table[1].type = FD_INHERITED;
	fd_table[2].type = FD_INHERITED;

	for (fd = 0; fd < 3; fd++) {
		fd_table[fd].src = malloc(sizeof(struct fd_backing));
		if (unlikely(fd_table[fd].src == NULL)) {
			xnd_perror("malloc");
			xnd_abort();
		}
		fd_table[fd].src->ref = 1;
		fd_table[fd].src->state = FD_STATE_NULL;

		/**
		 * Baked in once, here, rather than re-derived from
		 * whichever fd currently holds this type at restore
		 * time: dup()'ing one of these three onto a higher fd
		 * shares this same fd_backing (see fd_table_dup()), so
		 * the higher fd keeps the correct restore target even
		 * if fd 0/1/2 itself is later closed and reused for
		 * something else before checkpoint.
		 */
		fd_table[fd].src->reopen = fd;
	}
}

void fd_table_destroy(void)
{
	int fd;

	for (fd = 0; fd < MAXFILES; fd++) {
		if (fd_table[fd].type == FD_NULL) {
			continue;
		} else if (fd_table[fd].src != NULL) {
			fd_table[fd].src->ref--;
			if (fd_table[fd].src->ref == 0)
				free(fd_table[fd].src);
		}
	}
}

void fd_table_save(void)
{
	int fd;
	struct fd_state *state;
	struct fd_backing *src;

	for (fd = 0; fd < MAXFILES; fd++) {
		state = &fd_table[fd];
		if (state->type == FD_NULL || state->type == FD_INHERITED)
			continue;
		src = state->src;
		if (src && src->state != FD_STATE_SAVED)
			fd_backing_save(fd);
	}
}

void fd_table_restore(void)
{
	int fd;
	struct fd_state *state;
	struct fd_backing *src;

	/**
	 * fd 0/1/2 that the target explicitly closed before checkpoint
	 * have no backing left: fd_table_close() always clears its own
	 * slot's src once that reference is dropped, and fd_table_init()
	 * unconditionally gives all three a backing up front, so src ==
	 * NULL here can only mean "was inherited-open, then closed."
	 * Force them closed here too -- otherwise the freshly restarted
	 * process just keeps whatever xnd_restart happened to have open
	 * on those numbers.
	 */
	for (fd = 0; fd < 3; fd++) {
		if (fd_table[fd].src == NULL)
			close(fd);
	}

	for (fd = 0; fd < MAXFILES; fd++) {
		state = &fd_table[fd];
		if (state->type == FD_NULL)
			continue;

		src = state->src;
		if (src == NULL)
			continue;

		if (state->type == FD_INHERITED) {
			/**
			 * src->reopen is permanently the fd (0, 1, or 2)
			 * this backing was originally inherited on, set
			 * once in fd_table_init(). That holds even if
			 * the original fd has since been closed and
			 * reused for something else, since any fd dup'd
			 * from it while still inherited shares this same
			 * backing (fd_table_dup() aliases src, it never
			 * copies it).
			 */
			if (fd != src->reopen && dup2(src->reopen, fd) != fd) {
				xnd_perror("dup2");
				goto bad;
			}
			continue;
		}

		if (src->state == FD_STATE_RESTORED) {
			/* Shared backing already reopened by an earlier fd */
			if (dup2(src->reopen, fd) != fd) {
				xnd_perror("dup2");
				goto bad;
			}
			continue;
		}

		if (fd_backing_restore(fd) < 0) {
			xnd_error("fd_backing_restore error\n");
			goto bad;
		}
	}

	return;
bad:
	xnd_error("%s failed, aborting...\n", __func__);
	xnd_abort();
}

void fd_table_open(int fd, const char *path, int flags, mode_t mode)
{
	struct fd_state *state;

	if (fd_state_ignore()) {
		xnd_trace("Ignoring opened fd: %d\n", fd);
		return;
	}

	state = &fd_table[fd];
	pthread_mutex_lock(&fd_table_lock);

	state->type = FD_REGFILE;
	state->src = malloc(sizeof(struct fd_backing));
	if (unlikely(state->src == NULL)) {
		xnd_perror("malloc");
		xnd_abort();
	}
	state->src->ref = 1;
	state->src->mode = mode;
	state->src->flags = flags;
	state->src->state = FD_STATE_NULL;

	strncpy(state->src->path, path, strlen(path) + 1);
	pthread_mutex_unlock(&fd_table_lock);
}

void fd_table_dup(int oldfd, int newfd)
{
	struct fd_state *old, *new;

	if (fd_state_ignore()) {
		xnd_trace("Ignoring dup'd fd (old=%d, new=%d)\n",
			  oldfd, newfd);
		return;
	}

	old = &fd_table[oldfd];
	new = &fd_table[newfd];

	pthread_mutex_lock(&fd_table_lock);
	if (unlikely(old->src == NULL || old->type == FD_NULL)) {
		xnd_warn("dup'd fd untracked: %d\n", oldfd);
		goto out;
	}

	new->src = old->src;
	new->type = old->type;
	new->src->ref++;
out:
	pthread_mutex_unlock(&fd_table_lock);
}

void fd_table_close(int fd)
{
	struct fd_state *state;

	if (fd_state_ignore()) {
		xnd_trace("Ignored closed fd: %d\n", fd);
		return;
	}

	state = &fd_table[fd];
	pthread_mutex_lock(&fd_table_lock);

	if (state->type == FD_NULL || state->src == NULL) {
		pthread_mutex_unlock(&fd_table_lock);
		return;
	}

	state->type = FD_NULL;
	state->src->ref--;
	if (state->src->ref == 0)
		free(state->src);

	state->src = NULL;
	pthread_mutex_unlock(&fd_table_lock);
}
